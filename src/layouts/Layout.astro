---
import "../index.css";
import { ClientRouter } from "astro:transitions";
import GlobalBackground from "../components/Background";
import NavbarWrapper from "../components/NavbarWrapper";
import TerminalWrapper from "../components/TerminalWrapper";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  canonicalURL?: string | URL;
}

const {
  title = "AJ",
  description = "Personal website and portfolio of Abdul Jaber. Full Stack Developer specializing in modern web technologies, scalable systems, and beautiful UI.",
  image = "/assets/og.jpg",
  type = "website",
} = Astro.props;

const canonicalURL =
  Astro.props.canonicalURL ||
  new URL(Astro.url.pathname, Astro.site || Astro.url.origin);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://ajseven.me/#person",
  "name": "Abdul Jaber",
  "alternateName": ["AJ Seven", "AJ"],
  "url": "https://ajseven.me/",
  "image": "https://ajseven.me/assets/ME.webp",
  "jobTitle": "Full Stack Developer",
  "description":
    "Abdul Jaber, known online as AJ Seven (or AJ), is a full-stack engineer and tech explorer specializing in scalable systems, AI-driven solutions, and high-performance digital products.",
  "sameAs": [
    "https://github.com/aj-seven",
    "https://x.com/hii_ajseven",
    "https://www.linkedin.com/in/ajseven",
    "https://links.ajseven.me"
  ],
  "knowsAbout": [
    "Software Development",
    "Full Stack Development",
    "Web Development",
    "Artificial Intelligence",
    "Scalable Systems",
    "TypeScript",
    "JavaScript",
    "React",
    "Next.js",
    "Astro",
    "Node.js",
    "Tailwind CSS",
    "Desktop Applications",
    "Tauri",
    "Linux",
    "Electronics"
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Abdul Jaber" />
    <meta
      name="keywords"
      content="Abdul Jaber, AJ SEVEN, Full Stack Developer, Web Developer, React, Astro, Portfolio"
    />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL(image, Astro.site || Astro.url).toString()}
    />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content={new URL(image, Astro.site || Astro.url).toString()}
    />
    <meta property="twitter:image:alt" content={title} />

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/icon-192x192.png"
    />
    <link rel="shortcut icon" href="/icons/icon-192x192.png" type="image/png+xml" />

    <!-- Structured Data (JSON-LD) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema, null, 2)}
    />

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme-mode') || 'dark';
        if (theme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.remove('light');
          document.documentElement.classList.add('dark');
        }
      })();

      document.addEventListener('astro:after-swap', () => {
        const theme = localStorage.getItem('theme-mode') || 'dark';
        if (theme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.remove('light');
          document.documentElement.classList.add('dark');
        }
      });
    </script>

    <ClientRouter />
  </head>
  <body class="bg-[#050505] text-white">
    <GlobalBackground client:only="react" transition:persist="bg" />
    <NavbarWrapper client:only="react" transition:persist="nav" />

    <div id="main-content" class="relative z-10">
      <slot />
    </div>


    <TerminalWrapper client:only="react" transition:persist="terminal" />
  </body>
</html>
