---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const blogEntries = (await getCollection(
    "blog",
  )) as CollectionEntry<"blog">[];
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const formattedDate = entry.data.date
  ? entry.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<Layout
  title={`${entry.data.title} | Abdul Jaber`}
  description={entry.data.description}
  image={entry.data.image}
  type="article"
>
  <article
    class="min-h-screen w-full max-w-4xl mx-auto px-4 sm:px-6 pt-16 sm:pt-20 pb-20 text-left"
  >
    {/* Navigation */}
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-400 hover:text-white transition-colors mb-8"
    >
      ← Back to Writings
    </a>

    {/* Header */}
    <header class="mb-10 space-y-4 border-b border-white/5 pb-8">
      {
        formattedDate && (
          <span class="inline-block px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-xs font-mono font-medium text-blue-400 tracking-wider">
            {formattedDate}
          </span>
        )
      }

      <h1
        class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white leading-tight"
      >
        {entry.data.title}
      </h1>

      {
        entry.data.description && (
          <p class="text-base sm:text-lg text-zinc-400 leading-relaxed font-normal">
            {entry.data.description}
          </p>
        )
      }

      {
        entry.data.image && (
          <div class="w-full pt-4">
            <div class="w-full rounded-2xl overflow-hidden border border-gray/50 bg-zinc-900/40">
              <img
                src={entry.data.image}
                alt={entry.data.title}
                class="w-full h-auto object-cover max-h-[420px]"
              />
            </div>
          </div>
        )
      }

    </header>

    {/* Content */}
    <div
      class="prose dark:prose-invert prose-base max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-p:leading-relaxed prose-img:rounded-2xl"
    >
      <Content />
    </div>

    {/* Footer Author Dock */}
    <footer class="mt-16 pt-8 border-t border-white/5 space-y-6">
      <div class="flex items-center gap-4 p-5 rounded-2xl border border-white/5 bg-white/[0.02]">
        <div class="w-12 h-12 rounded-xl overflow-hidden border border-white/10 flex-shrink-0 bg-zinc-900">
          <img
            src="/assets/ME.webp"
            alt="Abdul Jaber"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="space-y-0.5 min-w-0">
          <p class="text-sm font-bold text-white">Written by Abdul Jaber</p>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Full-stack developer building scalable systems and AI-driven products.
          </p>
        </div>
      </div>

      <div class="flex items-center justify-between pt-2">
        <a
          href="/blog"
          class="text-xs font-semibold text-zinc-400 hover:text-white transition-colors"
        >
          ← All Writings
        </a>
        <a
          href="#main-content"
          class="text-xs font-semibold text-zinc-500 hover:text-zinc-300 transition-colors"
        >
          ↑ Back to top
        </a>
      </div>
    </footer>
  </article>
</Layout>
