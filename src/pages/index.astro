---
import Layout from '../layouts/Layout.astro';
import ElectricEffect from '../components/ElectricEffect';
import Hero from '../sections/Hero';
import About from '../sections/About';
import Projects from '../sections/Projects';
import Skills from '../sections/Skills';
import Blog from '../sections/Blog';
import Contact from '../sections/Contact';
import { getCollection } from 'astro:content';
import { formatBlogDate } from '../utils/date';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).valueOf() : 0;
  const dateB = b.data.date ? new Date(b.data.date).valueOf() : 0;
  return dateB - dateA;
});

const recentPosts = allPosts.slice(0, 2).map((post) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  date: formatBlogDate(post.data.date, { monthFormat: 'short' }) ?? undefined,
}));
---

<Layout>
  <ElectricEffect client:load />
  <main class="w-full max-w-4xl mx-auto px-4 sm:px-4 pt-16 sm:pt-20 pb-12 sm:pb-16 space-y-16 sm:space-y-24">
    <section id="home" class="scroll-mt-28"><Hero client:load /></section>
    <section id="about" class="scroll-mt-28"><About client:load /></section>
    <section id="projects" class="scroll-mt-28"><Projects limit={3} client:load /></section>
    <section id="skills" class="scroll-mt-28"><Skills client:load /></section>
    <section id="blog" class="scroll-mt-28"><Blog posts={recentPosts} client:load /></section>
    <section id="contact" class="scroll-mt-28"><Contact client:load /></section>
  </main>
</Layout>



